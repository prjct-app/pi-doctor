{
  "name": "@prjct.app/pi-doctor",
  "version": "0.3.1",
  "description": "Evidence-backed audits of Pi extensions and skills, separate disk/context costs, active-model recommendations and confirmed management actions.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "doctor",
    "cleanup"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-doctor/main/docs/cover.png"
  },
  "scripts": {
    "test": "export PI_CODING_AGENT_DIR=\"$(mktemp -d)\" PRJCT_HOME=\"$(mktemp -d)\" && node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "! grep -rn '\\blet\\b' src/ index.ts || (echo 'Use const and immutable values: no let bindings in src/ or index.ts' && exit 1)",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typebox": "^1.3.27",
    "@earendil-works/pi-tui": "1.1.0"
  },
  "license": "MIT",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "index.ts",
    "src",
    "docs/cover.png"
  ],
  "exports": {
    ".": "./index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-doctor.git"
  },
  "homepage": "https://github.com/prjct-app/pi-doctor#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-doctor/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@prjct.app/pi-tui-kit": "^0.3.5"
  }
}
